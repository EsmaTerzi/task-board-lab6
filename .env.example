# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth_db
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/auth_test_db

# JWT
JWT_SECRET=your-256-bit-secret-key-here-min-32-bytes-required
JWT_EXPIRES_IN=24h

# Bcrypt
BCRYPT_COST=12

# Password Reset
RESET_TOKEN_TTL_HOURS=1

# SMTP (Email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASS=password
SMTP_FROM=noreply@example.com

# Environment
NODE_ENV=development

# Server
PORT=3000

# E2E Tests
E2E_BASE_URL=http://localhost:3000
